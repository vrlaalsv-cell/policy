# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
dist/

# env / secrets
.env*
*.key
*.pem

# 파이프라인 산출물(대용량 원본) — 필요 시 조정
data/raw/
data/cabinet_minutes/*
!data/cabinet_minutes/README.md
!data/cabinet_minutes/.gitkeep

# OS / 편집기
.DS_Store
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# NAS 런타임 데이터 (컨테이너의 /app/data) — 스케줄러가 모은 기사·로그가 여기 쌓인다.
# git 작업트리를 건드리지 않아야 자동배포의 git pull 과 충돌하지 않는다.
/runtime/
data/news.js

# AI 분석 입력 배치 — build_ai_input.mjs 가 매번 지우고 다시 만드는 중간 산출물
# (원본은 web/data.js + data/news.json, 결과는 data/_ai_results.json)
data/_ai/
